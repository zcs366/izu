{
  "3": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "Load Flux FP8 All-in-One"},
    "inputs": {"ckpt_name": "Comfy Org-flux1-dev-fp8-with_clip_vae.safetensors"}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "CLIP Text Encode (Prompt)"},
    "inputs": {"text": "a serene mountain landscape at golden hour, photorealistic", "clip": ["3", 1]}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "CLIP Text Encode (Negative)"},
    "inputs": {"text": "ugly, blurry, low quality, deformed", "clip": ["3", 1]}
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "_meta": {"title": "Empty Latent Image (Flux = EmptyLatentImage, NOT EmptySD3LatentImage)"},
    "inputs": {"width": 1024, "height": 1024, "batch_size": 1}
  },
  "7": {
    "class_type": "KSampler",
    "_meta": {"title": "KSampler (Flux: cfg=1, steps=20-30)"},
    "inputs": {
      "seed": 42,
      "steps": 30,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["3", 0],
      "positive": ["4", 0],
      "negative": ["6", 0],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"},
    "inputs": {"samples": ["7", 0], "vae": ["3", 2]}
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save Image"},
    "inputs": {"filename_prefix": "flux_fp8", "images": ["8", 0]}
  }
}
